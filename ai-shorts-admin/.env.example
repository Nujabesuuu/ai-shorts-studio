# Скопіюйте в .env.local і впишіть свої значення:  cp .env.example .env.local
# .env.local у git не потрапляє. Next читає env лише на старті — після змін перезапустіть `npm run dev`.

# ── Supabase (обовʼязково для адмінки) ─────────────────────────────────────
# Supabase → Project Settings → API. Потрібен publishable-ключ, НЕ service role.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Telegram (опційно: бот-тригер флоу і звіти про прогін) ──────────────────
# Токен від @BotFather; chat id — від @userinfobot або getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dify (опційно: бенчмарк, кнопка «Зробити відео») ────────────────────────
# DIFY_API_BASE: https://api.dify.ai/v1 для хмари, або <your-host>/v1 для self-hosted.
# Ключі створюються ОКРЕМО для кожного застосунку після імпорту DSL:
#   Dify Studio → застосунок → API Access → API Key.
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_KEY_BASELINE=
DIFY_KEY_FINAL=
DIFY_KEY_DAY4=

# Вхідні параметри бенчмарку — однакові для всіх конфігурацій,
# інакше порівняння «до/після» нічого не доводить.
BENCH_NICHE=спешелті-кав'ярня в Києві
BENCH_PLATFORM=instagram
BENCH_FORMATS=reels,carousel,stories
BENCH_N_ITEMS=4

# ── Публічне демо (опційно) ─────────────────────────────────────────────────
# true → у шапці плашка «лише перегляд». Саму заборону запису забезпечує база:
# supabase/policies_demo_readonly.sql.
NEXT_PUBLIC_DEMO_MODE=
